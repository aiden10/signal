# Signal API
SERVER_URL=http://localhost:8080
SOCKET_URL=ws://localhost:8080/v1/receive/+11234567
# Regular "id" of the target chat, from /v1/groups/{phone_number}
GROUP_ID=
# Include the + and country code
PHONE_NUMBER=+11234567

# Gemini embeddings
GEMINI_API_KEY=
EMBEDDING_MODEL=gemini-embedding-001

# DeepSeek chat
DEEPSEEK_API_KEY=
# Optional, defaults to deepseek-flash
DEEPSEEK_MODEL=deepseek-flash
# Optional, defaults to https://api.deepseek.com
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Optional integration testing configuration
TESTING_SSH_COMMAND=ssh -L 8080:localhost:8080 -i ../ssh.key -N user@host
TESTING_SERVER_URL=http://localhost:8080
TESTING_PHONE_NUMBER=+11234567
